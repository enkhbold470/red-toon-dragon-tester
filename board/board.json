      "pins": {
        "1": "IO23",
        "2": "IO22",
        "3": "IO21",
        "4": "IO20",
        "5": "IO19",
        "6": "IO18",
        "7": "IO17/RX",
        "8": "IO16/TX",
        "9": "3V3",
        "10": "GND",
        "11": "5V"
      }
    },
    "J2": {
      "what": "Qwiic / STEMMA QT (JST SH 4-pin)",
      "pins": {
        "1": "GND",
        "2": "3V3",
        "3": "SDA (IO0)",
        "4": "SCL (IO14)"
      }
    }
  },
  "free_gpio": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    18,
    19,
    20,
    21,
