{
  "schema": "toon-dragon.board.v1",
  "name": "Red Eyes Toon Dragon",
  "design": "https://heypcb.ai/p/961e9487c50d?view=pcb",
  "mcu": {
    "module": "ESP32-C6-MINI-1U-H4",
    "chip": "ESP32-C6FH4",
    "flash_mb": 4,
    "psram": false,
    "cpu": "RISC-V 160 MHz",
    "radio": [
      "Wi-Fi 6 2.4 GHz",
      "BLE 5",
      "802.15.4 (Thread/Zigbee)"
    ],
    "antenna": "external only: U.FL connector on the module (-1U). Without an antenna, range is a few metres."
  },
  "board": {
    "size_mm": [
      22.86,
      40.64
    ],
    "layers": 4,
    "thickness_mm": 1.6,
    "mask": "red",
    "finish": "ENIG",
    "mounting_holes": "4x M2",
    "orientation": "front side: module at top, USB-C at bottom edge"
  },
  "power": {
    "input": "USB-C 5V (500 mA polyfuse F1, Schottky D4 -> 5V rail)",
    "rails": {
      "5V": "after D4 (~4.7 V); feeds the SK6812 eyes and J4.11",
      "3V3": "AP2112K-3.3 LDO (U2), 600 mA max; feeds module, J4.9, Qwiic"
    },
    "usb_cc": "5.1k pull-downs R1/R2 (sink)"
  },
  "gpio": {
    "eyes": {
      "gpio": 8,
      "what": "2x SK6812 RGB (GRB order), D1 (left) -> D2 (right) chain, 5V supply",
      "notes": "strapping pin with 10k pull-up R7: must be high at boot, don't pull it low externally"
    },
    "boot_button": {
      "gpio": 9,
      "active": "low",
      "pull": "10k up (R6)",
      "notes": "strapping pin; held at reset = download mode"
    },
    "reset_button": {
      "pin": "EN",
      "notes": "SW1, 10k up + 1uF (RC delay)"
    },
    "qwiic_sda": {
      "gpio": 0,
      "header": "J3.8",
      "notes": "no pull-ups on board"
    },
    "qwiic_scl": {
      "gpio": 14,
      "header": "J3.9",
      "notes": "no pull-ups on board"
    },
    "uart_tx": {
      "gpio": 16,
      "header": "J4.8"
    },
    "uart_rx": {
      "gpio": 17,
      "header": "J4.7"
    },
    "usb": {
      "gpio": [
        12,
        13
      ],
      "notes": "native USB Serial/JTAG = REPL + flashing. Never reconfigure."
    },
    "unconnected": [
      15
    ]
  },
  "headers": {
    "J3": {
      "side": "left",
      "pitch_mm": 2.54,
      "pins": {
        "1": "IO7",
        "2": "IO6",
        "3": "IO5",
        "4": "IO4",
        "5": "IO3",
        "6": "IO2",
        "7": "IO1",
        "8": "IO0/SDA",
        "9": "IO14/SCL"
      }
    },
    "J4": {
